
/*
 * Zaviya additions for the AYN Odin 2 Portal (appended to the base
 * qcs8550-ayn-odin2portal.dts by kernel-common/build.sh).
 *
 * The two buttons on the back (M1 left, M2 right) are not on the gamepad
 * MCU: AYN's Android reads them as plain SoC GPIOs 57 and 58, active low.
 * Give them a gpio-keys node of their own sending BTN_Z / BTN_C, the codes
 * our InputPlumber map already turns into the back paddles.
 */
&tlmm {
	back_keys_default: back-keys-default-state {
		pins = "gpio57", "gpio58";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-up;
	};
};

/ {
	gpio-keys-paddles {
		compatible = "gpio-keys";
		pinctrl-0 = <&back_keys_default>;
		pinctrl-names = "default";

		key-back-left {
			label = "Back M1";
			gpios = <&tlmm 57 GPIO_ACTIVE_LOW>;
			linux,code = <BTN_Z>;
			debounce-interval = <15>;
		};

		key-back-right {
			label = "Back M2";
			gpios = <&tlmm 58 GPIO_ACTIVE_LOW>;
			linux,code = <BTN_C>;
			debounce-interval = <15>;
		};
	};
};

#include "qcs8550-ayn-odin2-gyro.dtsi"

/*
 * Internal microphone: DMIC3 on SoundWire mic input 7, powered from MIC BIAS3.
 * The base route list only has the headset mic (AMIC2); the UCM profile
 * (AYN/Odin2/PortalMic.conf) selects the capture path.
 */
&{/sound} {
	audio-routing =
			"IN1_HPHL", "HPHL_OUT",
			"IN2_HPHR", "HPHR_OUT",
			"AMIC2", "MIC BIAS2",
			"TX SWR_INPUT1", "ADC2_OUTPUT",
			"DMIC3", "MIC BIAS3",
			"TX SWR_INPUT7", "DMIC3_OUTPUT";
};

/*
 * SoC deep sleep. With the PCIe GDSCs powering off in s2idle (0106), the
 * PCIe memory floor of 0019 is no longer needed for a clean wake, and it is
 * what keeps DDR out of self-refresh and CX up while the Portal sleeps:
 * drop it here, so pcie-qcom votes 0/0 on the memory path in s2idle as
 * mainline does.
 *
 * The crypto engine has no driver on 7.4 (CRYPTO_DEV_QCE depends on BROKEN
 * since 7.3), and the unbound node holds the sync_state of aggre2_noc and
 * mc_virt, so the DDR path keeps its boot-time votes until the cmdline's
 * fw_devlink.sync_state=timeout forces the sync. Disable it, as
 * ROCKNIX/distribution PR 3636 does for the AYN boards (Jacob Cook).
 */
&pcie0_opp_table {
	/delete-node/ opp-suspend-1;
};

&crypto {
	status = "disabled";
};
