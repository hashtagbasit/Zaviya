@@ -41,6 +42,32 @@ struct panel_info {
 
 	u16 frame_len_120;
 	u16 frame_len_60;
+
+	/*
+	 * Panels that switch modes while on (switch_mode): the mode the panel
+	 * runs, and the changes (VTDR6130_PENDING_*) waiting to be sent in the
+	 * display driver's command window, see vtdr6130_resync_pending().
+	 */
+	struct drm_display_mode cur_mode;
+	bool cur_mode_valid;
+	/* Retries left for a frame length send that failed; under cmd_lock */
+	u8 send_tries;
+	/* The last frame length send failed, maybe in part; under cmd_lock */
+	bool frame_len_dirty;
+	unsigned long pending;
+	/* Sends the pending changes when no commit comes to take them. */
+	struct delayed_work pending_work;
+};
+
+/* Bits of panel_info.pending */
+#define VTDR6130_PENDING_FRAME_LEN	0
+
+/* How a panel model takes its per-unit frame length (sysfs frame_len_120/60) */
+struct vtdr6130_frame_len {
+	u16 def_120, min_120, max_120;
+	u16 def_60, min_60, max_60;
+	/* Send the new values to the enabled panel; called with cmd_lock held */
+	int (*apply)(struct panel_info *pinfo);
 };
 
 struct panel_desc {
@@ -70,6 +97,8 @@ struct panel_desc {
 	/* Built-in EDID for panels whose users (gamescope) need one. */
 	const u8 *edid;
 	size_t edid_size;
+	/* Per-unit refresh calibration; without it frame_len_* are refused */
+	const struct vtdr6130_frame_len *frame_len;
 
 	struct drm_dsc_config dsc;
 };
@@ -130,6 +159,25 @@ static void vtdr6130_rp6_set_frame_len(struct mipi_dsi_multi_context *dsi_ctx,
 	mipi_dsi_generic_write_multi(dsi_ctx, payload, sizeof(payload));
 }
 
+/* ROCKNIX PR 3484: the RP6 takes a new frame length at once, in HS mode. */
+static int vtdr6130_rp6_apply_frame_len(struct panel_info *pinfo)
+{
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = pinfo->dsi };
+
+	pinfo->dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
+	vtdr6130_rp6_set_frame_len(&dsi_ctx, pinfo);
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0xF0, 0xAA, 0x00);
+	pinfo->dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+
+	return dsi_ctx.accum_err;
+}
+
+static const struct vtdr6130_frame_len vtdr6130_rp6_frame_len = {
+	.def_120 = 0x1c, .min_120 = 0x10, .max_120 = 0x80,
+	.def_60 = 0x7d0, .min_60 = 0x76c, .max_60 = 0x834,
+	.apply = vtdr6130_rp6_apply_frame_len,
+};
+
 static int vtdr6130_rp6_init_sequence(struct panel_info *pinfo)
 {
 	struct mipi_dsi_multi_context dsi_ctx = { .dsi = pinfo->dsi };
@@ -279,6 +327,7 @@ static struct panel_desc vtdr6130_rp6_desc = {
 	.format = MIPI_DSI_FMT_RGB888,
 	.mode_flags =  MIPI_DSI_MODE_NO_EOT_PACKET | MIPI_DSI_CLOCK_NON_CONTINUOUS | MIPI_DSI_MODE_LPM,
 	.init_sequence = vtdr6130_rp6_init_sequence,
+	.frame_len = &vtdr6130_rp6_frame_len,
 	.dsc = {
 		.dsc_version_major = 0x1,
 		.dsc_version_minor = 0x1,
@@ -304,15 +353,47 @@ static struct panel_desc vtdr6130_rp6_desc = {
  * (offset 0x0b); rates up to 60 Hz use the latter.
  */
 #define VTDR6130_PORTAL_MIN_FRAME_LEN	18
+/* Lowest frame length a per-unit calibration may give (Android's is 18) */
+#define VTDR6130_PORTAL_MIN_CAL_FRAME_LEN	10
+/* Retries of a failed frame length send before it waits for the next change */
+#define VTDR6130_PORTAL_SEND_TRIES	3
 
-static u16 vtdr6130_portal_mode_frame_len(const struct drm_display_mode *m,
+/*
+ * Per-unit refresh calibration. The panel runs from its own oscillator, so
+ * a unit's real rate differs from the mode's by a fixed factor (one unit:
+ * 120.55 Hz at the nominal 120 Hz mode). AYN's Android corrects it per unit
+ * (qcom,quec-refresh-120hz/60hz, defaults 18 and 1974, with a factory value
+ * from /mnt/vendor/persist/odin/fps); ROCKNIX and Armada expose the two
+ * slot lengths as frame_len_120 and frame_len_60 in sysfs and apply a saved
+ * value at boot. This panel takes the same two attributes, so their tools
+ * work unchanged, but the modes keep their nominal timings for user space:
+ * each attribute's distance from Android's default is an offset in lines at
+ * that slot's nominal mode, and a mode in that slot (rates above 60 Hz use
+ * the 120 Hz slot) gets the offset scaled by its length, because the error
+ * is a factor on the line time: frame length = front porch +
+ * round(offset * vtotal / nominal vtotal). At the defaults (offset 0) this is
+ * the front porch, as before.
+ */
+static u16 vtdr6130_portal_mode_frame_len(struct panel_info *pinfo,
+					  const struct drm_display_mode *m,
 					  bool *slow)
 {
+	const struct vtdr6130_frame_len *cal = pinfo->desc->frame_len;
+	const struct drm_display_mode *nom;
+	int fl = max_t(int, m->vsync_start - m->vdisplay, VTDR6130_PORTAL_MIN_FRAME_LEN);
+	int off;
+
 	*slow = drm_mode_vrefresh(m) <= 60;
-	return max_t(int, m->vsync_start - m->vdisplay, VTDR6130_PORTAL_MIN_FRAME_LEN);
+	nom = &pinfo->desc->modes[*slow ? 1 : 0];
+	off = *slow ? (int)READ_ONCE(pinfo->frame_len_60) - cal->def_60 :
+		      (int)READ_ONCE(pinfo->frame_len_120) - cal->def_120;
+	if (off)
+		fl += DIV_ROUND_CLOSEST(off * (int)m->vtotal, (int)nom->vtotal);
+
+	return clamp_t(int, fl, VTDR6130_PORTAL_MIN_CAL_FRAME_LEN, U16_MAX);
 }
 
-static u16 vtdr6130_portal_frame_len(struct panel_info *pinfo, bool *slow)
+static const struct drm_display_mode *vtdr6130_portal_mode(struct panel_info *pinfo)
 {
 	const struct drm_display_mode *m = &pinfo->desc->modes[0];
 	struct drm_connector *connector = pinfo->connector;
@@ -321,9 +402,64 @@ static u16 vtdr6130_portal_frame_len(struct panel_info *pinfo, bool *slow)
 	    connector->state->crtc->state->mode.vdisplay == m->vdisplay)
 		m = &connector->state->crtc->state->mode;
 
-	return vtdr6130_portal_mode_frame_len(m, slow);
+	return m;
+}
+
+/* The frame length of @mode, sent in LP mode as Android does; cmd_lock held */
+static int vtdr6130_portal_send_frame_len(struct panel_info *pinfo,
+					  const struct drm_display_mode *mode)
+{
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = pinfo->dsi };
+	bool slow;
+	u16 fl;
+	int ret;
+
+	/* A change requested from now on is not in this write */
+	clear_bit(VTDR6130_PENDING_FRAME_LEN, &pinfo->pending);
+	smp_mb__after_atomic();
+	fl = vtdr6130_portal_mode_frame_len(pinfo, mode, &slow);
+
+	/* Android sends its timing switch command in LP mode, as the on-command */
+	pinfo->dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+
+	mipi_dsi_dcs_write_var_seq_multi(&dsi_ctx, 0x6c, slow ? 0x01 : 0x00);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0xaa, 0x10);
+	mipi_dsi_dcs_write_var_seq_multi(&dsi_ctx, 0x65, slow ? 0x0b : 0x04);
+	mipi_dsi_dcs_write_var_seq_multi(&dsi_ctx, 0xb1, fl >> 8, fl & 0xff);
+	/*
+	 * Back to page 0, where the on-command leaves the panel, also after a
+	 * failed write (the multi helpers skip everything after an error).
+	 */
+	ret = dsi_ctx.accum_err;
+	dsi_ctx.accum_err = 0;
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0xaa, 0x00);
+
+	return ret ?: dsi_ctx.accum_err;
 }
 
+/*
+ * A new calibration value for the enabled panel: the display driver sends
+ * it in its command window after the next frame's transfer (the path of a
+ * refresh switch, drm_panel_funcs.resync_pending); pending_work sends it
+ * if no commit comes within 100 ms, when the link is idle anyway.
+ */
+static int vtdr6130_portal_apply_frame_len(struct panel_info *pinfo)
+{
+	pinfo->send_tries = VTDR6130_PORTAL_SEND_TRIES;
+	set_bit(VTDR6130_PENDING_FRAME_LEN, &pinfo->pending);
+	if (pinfo->enabled)
+		mod_delayed_work(system_dfl_wq, &pinfo->pending_work, msecs_to_jiffies(100));
+
+	return 0;
+}
+
+static const struct vtdr6130_frame_len vtdr6130_portal_frame_len = {
+	/* Android: qcom,quec-refresh-120hz = <0x12>, -60hz = <0x7b6> */
+	.def_120 = 18, .min_120 = VTDR6130_PORTAL_MIN_CAL_FRAME_LEN, .max_120 = 118,
+	.def_60 = 1974, .min_60 = 1874, .max_60 = 2074,
+	.apply = vtdr6130_portal_apply_frame_len,
+};
+
 /*
  * In command mode the panel scans out at its own frame length and only
  * takes frames from the host, so a mode that differs in the vertical front
@@ -355,36 +491,68 @@ static bool vtdr6130_portal_can_switch_mode(struct panel_info *pinfo,
 	       vfp >= VTDR6130_PORTAL_MIN_FRAME_LEN && vfp <= U16_MAX;
 }
 
+/*
+ * A refresh switch (a new @mode), or the running @mode again when changes
+ * are pending (vtdr6130_resync_pending()); both from the display driver's
+ * command window, or from pending_work.
+ */
 static int vtdr6130_portal_switch_mode(struct panel_info *pinfo,
 				       const struct drm_display_mode *mode)
 {
-	struct mipi_dsi_multi_context dsi_ctx = { .dsi = pinfo->dsi };
-	bool slow;
-	u16 fl = vtdr6130_portal_mode_frame_len(mode, &slow);
+	bool change;
+	int ret = 0;
 
 	mutex_lock(&pinfo->cmd_lock);
 
-	/* Android sends its timing switch command in LP mode, as the on-command */
-	pinfo->dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+	if (!pinfo->enabled) {
+		mutex_unlock(&pinfo->cmd_lock);
+		return -EINVAL;
+	}
 
-	mipi_dsi_dcs_write_var_seq_multi(&dsi_ctx, 0x6c, slow ? 0x01 : 0x00);
-	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0xaa, 0x10);
-	mipi_dsi_dcs_write_var_seq_multi(&dsi_ctx, 0x65, slow ? 0x0b : 0x04);
-	mipi_dsi_dcs_write_var_seq_multi(&dsi_ctx, 0xb1, fl >> 8, fl & 0xff);
-	/* Back to page 0, where the on-command leaves the panel */
-	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0xaa, 0x00);
+	change = !pinfo->cur_mode_valid ||
+		 !drm_mode_match(&pinfo->cur_mode, mode,
+				 DRM_MODE_MATCH_TIMINGS | DRM_MODE_MATCH_CLOCK);
+	if (change)
+		pinfo->send_tries = VTDR6130_PORTAL_SEND_TRIES;
+	if (change || test_bit(VTDR6130_PENDING_FRAME_LEN, &pinfo->pending)) {
+		ret = vtdr6130_portal_send_frame_len(pinfo, mode);
+		pinfo->frame_len_dirty = ret != 0;
+	}
+
+	if (mode != &pinfo->cur_mode)
+		drm_mode_copy(&pinfo->cur_mode, mode);
+	pinfo->cur_mode_valid = true;
+
+	/*
+	 * The display driver runs @mode from now on either way. If the panel
+	 * did not take its frame length, keep it pending: the next commit, or
+	 * pending_work, sends it again, VTDR6130_PORTAL_SEND_TRIES times at most.
+	 */
+	if (ret && pinfo->send_tries) {
+		pinfo->send_tries--;
+		set_bit(VTDR6130_PENDING_FRAME_LEN, &pinfo->pending);
+		mod_delayed_work(system_dfl_wq, &pinfo->pending_work, msecs_to_jiffies(100));
+	}
 
 	mutex_unlock(&pinfo->cmd_lock);
 
-	return dsi_ctx.accum_err;
+	return ret;
 }
 
