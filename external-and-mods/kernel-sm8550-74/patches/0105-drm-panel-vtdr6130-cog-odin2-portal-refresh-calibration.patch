diff --git a/drivers/gpu/drm/drm_panel.c b/drivers/gpu/drm/drm_panel.c
index bd034a8..5cf5aed 100644
--- a/drivers/gpu/drm/drm_panel.c
+++ b/drivers/gpu/drm/drm_panel.c
@@ -957,6 +957,27 @@ int drm_panel_switch_mode(struct drm_panel *panel,
 }
 EXPORT_SYMBOL(drm_panel_switch_mode);
 
+/**
+ * drm_panel_resync_pending - check whether an enabled panel waits to send a
+ *	change of its own between two frames
+ * @panel: DRM panel
+ *
+ * Display drivers that call drm_panel_switch_mode() ask this on every
+ * commit; if it returns true they call drm_panel_switch_mode() with the
+ * running mode, at the point in the commit where they make a mode switch.
+ *
+ * Return: true if such a change is pending.
+ */
+bool drm_panel_resync_pending(struct drm_panel *panel)
+{
+	if (!panel || !panel->enabled || !panel->funcs ||
+	    !panel->funcs->resync_pending || !panel->funcs->switch_mode)
+		return false;
+
+	return panel->funcs->resync_pending(panel);
+}
+EXPORT_SYMBOL(drm_panel_resync_pending);
+
 /**
  * drm_panel_get - Acquire a panel reference
  * @panel: DRM panel
diff --git a/drivers/gpu/drm/msm/disp/dpu1/dpu_crtc.c b/drivers/gpu/drm/msm/disp/dpu1/dpu_crtc.c
index e966a2e..a99b840 100644
--- a/drivers/gpu/drm/msm/disp/dpu1/dpu_crtc.c
+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_crtc.c
@@ -940,6 +940,12 @@ static void dpu_crtc_atomic_begin(struct drm_crtc *crtc,
 			dpu_encoder_switch_mode(encoder,
 						&old_crtc_state->adjusted_mode,
 						&crtc->state->adjusted_mode);
+	} else if (crtc->state->active &&
+		   !drm_atomic_crtc_needs_modeset(crtc->state)) {
+		/* A panel change waiting for the same window (calibration) */
+		drm_for_each_encoder_mask(encoder, crtc->dev,
+					  crtc->state->encoder_mask)
+			dpu_encoder_panel_resync(encoder);
 	}
 
 	_dpu_crtc_check_and_setup_lm_bounds(crtc, crtc->state);
diff --git a/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder.c b/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder.c
index fa43b9e..4af9506 100644
--- a/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder.c
+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder.c
@@ -807,6 +807,41 @@ void dpu_encoder_switch_mode(struct drm_encoder *drm_enc,
 			      DRM_MODE_ARG(new_mode), ret);
 }
 
+/**
+ * dpu_encoder_panel_resync - let a command mode panel send a change of its
+ *	own (a frame length calibration) between two frames
+ * @drm_enc: Pointer to drm encoder structure
+ *
+ * Called from the CRTC's atomic_begin of a commit without a mode change.
+ * Costs one check unless the panel has something pending; then it waits
+ * for the previous frame's transfer, like dpu_encoder_switch_mode(), and
+ * hands the panel its running mode. The timings do not change, so the
+ * tear check stays as it is.
+ */
+void dpu_encoder_panel_resync(struct drm_encoder *drm_enc)
+{
+	struct dpu_encoder_virt *dpu_enc = to_dpu_encoder_virt(drm_enc);
+	struct msm_drm_private *priv = drm_enc->dev->dev_private;
+	const struct msm_display_info *disp_info = &dpu_enc->disp_info;
+	struct msm_dsi *msm_dsi;
+	int ret;
+
+	if (disp_info->intf_type != INTF_DSI || !disp_info->is_cmd_mode ||
+	    disp_info->num_of_h_tiles != 1 || dpu_enc->num_phys_encs != 1 ||
+	    !dpu_enc->phys_encs[0])
+		return;
+
+	msm_dsi = priv->kms->dsi[disp_info->h_tile_instance[0]];
+	if (!msm_dsi_panel_resync_pending(msm_dsi))
+		return;
+
+	dpu_encoder_wait_for_tx_complete(drm_enc);
+
+	ret = msm_dsi_switch_mode(msm_dsi, &dpu_enc->phys_encs[0]->cached_mode);
+	if (ret)
+		DPU_ERROR_ENC(dpu_enc, "panel resync failed: %d\n", ret);
+}
+
 bool dpu_encoder_needs_modeset(struct drm_encoder *drm_enc, struct drm_atomic_commit *state)
 {
 	struct drm_connector *connector;
diff --git a/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder.h b/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder.h
index 158cba8..c566c01 100644
--- a/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder.h
+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder.h
@@ -97,6 +97,8 @@ void dpu_encoder_switch_mode(struct drm_encoder *drm_enc,
 			     const struct drm_display_mode *old_mode,
 			     const struct drm_display_mode *new_mode);
 
+void dpu_encoder_panel_resync(struct drm_encoder *drm_enc);
+
 void dpu_encoder_prepare_wb_job(struct drm_encoder *drm_enc,
 		struct drm_writeback_job *job);
 
diff --git a/drivers/gpu/drm/msm/dsi/dsi_manager.c b/drivers/gpu/drm/msm/dsi/dsi_manager.c
index 772b9e1..6247872 100644
--- a/drivers/gpu/drm/msm/dsi/dsi_manager.c
+++ b/drivers/gpu/drm/msm/dsi/dsi_manager.c
@@ -688,3 +688,19 @@ int msm_dsi_switch_mode(struct msm_dsi *msm_dsi,
 
 	return drm_panel_switch_mode(panel, mode);
 }
+
+/**
+ * msm_dsi_panel_resync_pending - check whether the command mode panel behind
+ *	a running link waits to send a change between two frames
+ * @msm_dsi: DSI device
+ *
+ * Return: true if msm_dsi_switch_mode() with the running mode should be
+ * called in this commit (see drm_panel_resync_pending()).
+ */
+bool msm_dsi_panel_resync_pending(struct msm_dsi *msm_dsi)
+{
+	if (!msm_dsi || IS_BONDED_DSI() || !msm_dsi_is_cmd_mode(msm_dsi))
+		return false;
+
+	return drm_panel_resync_pending(drm_panel_bridge_get_panel(msm_dsi->next_bridge));
+}
diff --git a/drivers/gpu/drm/msm/msm_drv.h b/drivers/gpu/drm/msm/msm_drv.h
index 0c3f2d7..d300425 100644
--- a/drivers/gpu/drm/msm/msm_drv.h
+++ b/drivers/gpu/drm/msm/msm_drv.h
@@ -308,6 +308,7 @@ bool msm_dsi_can_switch_mode(struct msm_dsi *msm_dsi,
 			     const struct drm_display_mode *new_mode);
 int msm_dsi_switch_mode(struct msm_dsi *msm_dsi,
