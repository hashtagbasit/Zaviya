From: TheWeaklessOne <41053514+TheWeaklessOne@users.noreply.github.com>
Subject: [PATCH] drm/panel: vtdr6130-cog: Odin 2 Portal refresh rate switch while on

Implement the drm_panel can_switch_mode()/switch_mode() hooks (patch 0102)
for the Portal panel: a mode that differs from the running one in the
vertical front porch only is set by sending the frame length to the
running panel, the way Android's qcom,mdss-dsi-timing-switch-command for
this panel node does it: 0x6c slot, page 0x10, 0x65 offset, 0xb1 frame
length, all in LP mode. The page is then set back to 0, where the
on-command leaves it. Same slot rule as the init sequence: 0x6c 0x01 and
offset 0x0b up to 60 Hz, 0x6c 0x00 and offset 0x04 above.

Front porches below 18 lines (which the init sequence clamps) or above
0xffff still take a full modeset, as does any other change.

The backlight callbacks toggle MIPI_DSI_MODE_LPM around their commands and
can run at any time; a mutex now keeps them and the switch sequence from
interleaving, so a brightness write cannot land between the page select,
the 0x65 offset and the 0xb1 write.
---
 .../gpu/drm/panel/panel-visionox-vtdr6130-cog.c    | 138 +++++++++++++++++++--
 1 file changed, 126 insertions(+), 12 deletions(-)

diff --git a/drivers/gpu/drm/panel/panel-visionox-vtdr6130-cog.c b/drivers/gpu/drm/panel/panel-visionox-vtdr6130-cog.c
index 9650f53b4..2d279b485 100644
--- a/drivers/gpu/drm/panel/panel-visionox-vtdr6130-cog.c
+++ b/drivers/gpu/drm/panel/panel-visionox-vtdr6130-cog.c
@@ -36,6 +36,9 @@ struct panel_info {
 	struct regulator_bulk_data *supplies;
 	bool enabled;
 
+	/* Serialises command sequences sent while the panel is on. */
+	struct mutex cmd_lock;
+
 	u16 frame_len_120;
 	u16 frame_len_60;
 };
@@ -52,6 +55,12 @@ struct panel_desc {
 	const struct drm_display_mode *modes;
 	unsigned int num_modes;
 	int (*init_sequence)(struct panel_info *pinfo);
+	/* Optional: mode changes the enabled panel can make (drm_panel_funcs). */
+	bool (*can_switch_mode)(struct panel_info *pinfo,
+				const struct drm_display_mode *old_mode,
+				const struct drm_display_mode *new_mode);
+	int (*switch_mode)(struct panel_info *pinfo,
+			   const struct drm_display_mode *mode);
 	unsigned int bl_max;
 	/* Built-in EDID for panels whose users (gamescope) need one. */
 	const u8 *edid;
@@ -286,19 +295,78 @@ static struct panel_desc vtdr6130_rp6_desc = {
  */
 #define VTDR6130_PORTAL_MIN_FRAME_LEN	18
 
+static u16 vtdr6130_portal_mode_frame_len(const struct drm_display_mode *m,
+					  bool *slow)
+{
+	*slow = drm_mode_vrefresh(m) <= 60;
+	return max_t(int, m->vsync_start - m->vdisplay, VTDR6130_PORTAL_MIN_FRAME_LEN);
+}
+
 static u16 vtdr6130_portal_frame_len(struct panel_info *pinfo, bool *slow)
 {
 	const struct drm_display_mode *m = &pinfo->desc->modes[0];
 	struct drm_connector *connector = pinfo->connector;
-	u16 fl;
 
 	if (connector && connector->state && connector->state->crtc &&
 	    connector->state->crtc->state->mode.vdisplay == m->vdisplay)
 		m = &connector->state->crtc->state->mode;
 
-	fl = max_t(int, m->vsync_start - m->vdisplay, VTDR6130_PORTAL_MIN_FRAME_LEN);
-	*slow = drm_mode_vrefresh(m) <= 60;
-	return fl;
+	return vtdr6130_portal_mode_frame_len(m, slow);
+}
+
+/*
+ * In command mode the panel scans out at its own frame length and only
+ * takes frames from the host, so a mode that differs in the vertical front
+ * porch alone (gamescope's generated rates) can be set while the panel is
+ * on, the way Android does it with this panel node's
+ * qcom,mdss-dsi-timing-switch-command: 0x6c slot, then 0x65 offset and
+ * 0xb1 frame length on page 0x10.
+ */
+static bool vtdr6130_portal_can_switch_mode(struct panel_info *pinfo,
+					    const struct drm_display_mode *old_mode,
+					    const struct drm_display_mode *new_mode)
+{
+	const struct drm_display_mode *m = &pinfo->desc->modes[0];
+	int dv = new_mode->vsync_start - old_mode->vsync_start;
+	int vfp = new_mode->vsync_start - new_mode->vdisplay;
+
+	return old_mode->clock == new_mode->clock &&
+	       old_mode->hdisplay == m->hdisplay &&
+	       new_mode->hdisplay == m->hdisplay &&
+	       old_mode->hsync_start == new_mode->hsync_start &&
+	       old_mode->hsync_end == new_mode->hsync_end &&
+	       old_mode->htotal == new_mode->htotal &&
+	       old_mode->vdisplay == m->vdisplay &&
+	       new_mode->vdisplay == m->vdisplay &&
+	       new_mode->vsync_end - old_mode->vsync_end == dv &&
+	       new_mode->vtotal - old_mode->vtotal == dv &&
+	       old_mode->flags == new_mode->flags &&
+	       old_mode->vsync_start - old_mode->vdisplay >= VTDR6130_PORTAL_MIN_FRAME_LEN &&
+	       vfp >= VTDR6130_PORTAL_MIN_FRAME_LEN && vfp <= U16_MAX;
+}
+
+static int vtdr6130_portal_switch_mode(struct panel_info *pinfo,
+				       const struct drm_display_mode *mode)
+{
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = pinfo->dsi };
+	bool slow;
+	u16 fl = vtdr6130_portal_mode_frame_len(mode, &slow);
+
+	mutex_lock(&pinfo->cmd_lock);
+
+	/* Android sends its timing switch command in LP mode, as the on-command */
+	pinfo->dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+
+	mipi_dsi_dcs_write_var_seq_multi(&dsi_ctx, 0x6c, slow ? 0x01 : 0x00);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0xaa, 0x10);
+	mipi_dsi_dcs_write_var_seq_multi(&dsi_ctx, 0x65, slow ? 0x0b : 0x04);
+	mipi_dsi_dcs_write_var_seq_multi(&dsi_ctx, 0xb1, fl >> 8, fl & 0xff);
+	/* Back to page 0, where the on-command leaves the panel */
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0xaa, 0x00);
+
+	mutex_unlock(&pinfo->cmd_lock);
+
+	return dsi_ctx.accum_err;
 }
 
 static int vtdr6130_portal_init_sequence(struct panel_info *pinfo)
@@ -425,6 +493,8 @@ static struct panel_desc vtdr6130_portal_desc = {
 	.format = MIPI_DSI_FMT_RGB888,
 	.mode_flags =  MIPI_DSI_MODE_NO_EOT_PACKET | MIPI_DSI_CLOCK_NON_CONTINUOUS | MIPI_DSI_MODE_LPM,
 	.init_sequence = vtdr6130_portal_init_sequence,
+	.can_switch_mode = vtdr6130_portal_can_switch_mode,
+	.switch_mode = vtdr6130_portal_switch_mode,
 	/* Android: qcom,mdss-dsi-bl-max-level = <0xd55> */
 	.bl_max = 3413,
 	.edid = vtdr6130_portal_edid,
@@ -571,6 +641,38 @@ static enum drm_panel_orientation vtdr6130_get_orientation(struct drm_panel *pan
 	return pinfo->orientation;
 }
 
+static bool vtdr6130_can_switch_mode(struct drm_panel *panel,
+				     const struct drm_display_mode *old_mode,
+				     const struct drm_display_mode *new_mode)
+{
+	struct panel_info *pinfo = to_panel_info(panel);
+
+	if (!pinfo->desc->can_switch_mode || !pinfo->desc->switch_mode)
+		return false;
+
+	return pinfo->desc->can_switch_mode(pinfo, old_mode, new_mode);
+}
+
+static int vtdr6130_switch_mode(struct drm_panel *panel,
+				const struct drm_display_mode *mode)
+{
+	struct panel_info *pinfo = to_panel_info(panel);
+	int ret;
+
+	if (!pinfo->desc->switch_mode)
+		return -EOPNOTSUPP;
+
+	if (!pinfo->enabled)
+		return -EINVAL;
+
+	ret = pinfo->desc->switch_mode(pinfo, mode);
+	if (ret < 0)
+		dev_err(panel->dev, "failed to switch to " DRM_MODE_FMT ": %d\n",
+			DRM_MODE_ARG(mode), ret);
+
+	return ret;
+}
+
 static const struct drm_panel_funcs vtdr6130_panel_funcs = {
 	.disable = vtdr6130_disable,
 	.enable = vtdr6130_enable,
@@ -578,40 +680,48 @@ static const struct drm_panel_funcs vtdr6130_panel_funcs = {
 	.unprepare = vtdr6130_unprepare,
 	.get_modes = vtdr6130_get_modes,
 	.get_orientation = vtdr6130_get_orientation,
+	.can_switch_mode = vtdr6130_can_switch_mode,
+	.switch_mode = vtdr6130_switch_mode,
 };
 
 static int vtdr6130_bl_update_status(struct backlight_device *bl)
 {
 	struct mipi_dsi_device *dsi = bl_get_data(bl);
+	struct panel_info *pinfo = mipi_dsi_get_drvdata(dsi);
 	u16 brightness = backlight_get_brightness(bl);
 	int ret;
 
+	mutex_lock(&pinfo->cmd_lock);
+
 	dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
 
 	ret = mipi_dsi_dcs_set_display_brightness_large(dsi, brightness);
-	if (ret < 0)
-		return ret;
+	if (ret >= 0)
+		dsi->mode_flags |= MIPI_DSI_MODE_LPM;
 
-	dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+	mutex_unlock(&pinfo->cmd_lock);
 
-	return 0;
+	return ret < 0 ? ret : 0;
 }
 
 static int vtdr6130_bl_get_brightness(struct backlight_device *bl)
 {
 	struct mipi_dsi_device *dsi = bl_get_data(bl);
+	struct panel_info *pinfo = mipi_dsi_get_drvdata(dsi);
 	u16 brightness;
 	int ret;
 
+	mutex_lock(&pinfo->cmd_lock);
+
 	dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
 
 	ret = mipi_dsi_dcs_get_display_brightness_large(dsi, &brightness);
-	if (ret < 0)
-		return ret;
+	if (ret >= 0)
+		dsi->mode_flags |= MIPI_DSI_MODE_LPM;
 
-	dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+	mutex_unlock(&pinfo->cmd_lock);
 
-	return brightness;
+	return ret < 0 ? ret : brightness;
 }
 
 static const struct backlight_ops vtdr6130_bl_ops = {
@@ -738,6 +848,10 @@ static int vtdr6130_probe(struct mipi_dsi_device *dsi)
 	pinfo->dsi = dsi;
 	mipi_dsi_set_drvdata(dsi, pinfo);
 
+	ret = devm_mutex_init(dev, &pinfo->cmd_lock);
+	if (ret)
+		return ret;
+
 	pinfo->frame_len_120 = 0x1C;
 	pinfo->frame_len_60 = 0x7D0;
 
