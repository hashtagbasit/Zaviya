+static bool dsi_mgr_mode_vfp_change_only(const struct drm_display_mode *a,
+					 const struct drm_display_mode *b)
+{
+	int dv = b->vsync_start - a->vsync_start;
+
+	return a->clock == b->clock &&
+	       a->hdisplay == b->hdisplay &&
+	       a->hsync_start == b->hsync_start &&
+	       a->hsync_end == b->hsync_end &&
+	       a->htotal == b->htotal &&
+	       a->hskew == b->hskew &&
+	       a->vdisplay == b->vdisplay &&
+	       b->vsync_end - a->vsync_end == dv &&
+	       b->vtotal - a->vtotal == dv &&
+	       a->vscan == b->vscan &&
+	       a->flags == b->flags;
+}
+
+/**
+ * msm_dsi_can_switch_mode - check whether a running link can change mode
+ * @msm_dsi: DSI device
+ * @old_mode: adjusted mode the link runs
+ * @new_mode: adjusted mode to switch to
+ *
+ * A command mode host sends each frame as a memory write paced by the
+ * panel's TE and never transmits vertical porches: the panel scans out at
+ * its own frame length. A change of the vertical front porch alone, at the
+ * same pixel clock, leaves the link (clocks, timing registers, DSC) as it
+ * is and only needs the panel to change its frame length, if it can.
+ *
+ * Return: true if msm_dsi_switch_mode() can do the switch without a
+ * modeset.
+ */
+bool msm_dsi_can_switch_mode(struct msm_dsi *msm_dsi,
+			     const struct drm_display_mode *old_mode,
+			     const struct drm_display_mode *new_mode)
+{
+	struct drm_panel *panel;
+
+	if (!msm_dsi || IS_BONDED_DSI() || !msm_dsi_is_cmd_mode(msm_dsi))
+		return false;
+
+	if (!dsi_mgr_mode_vfp_change_only(old_mode, new_mode))
+		return false;
+
+	panel = drm_panel_bridge_get_panel(msm_dsi->next_bridge);
+
+	return drm_panel_can_switch_mode(panel, old_mode, new_mode);
+}
+
+/**
+ * msm_dsi_switch_mode - switch a running link to a mode accepted by
+ *	msm_dsi_can_switch_mode()
+ * @msm_dsi: DSI device
+ * @mode: adjusted mode to switch to
+ *
+ * Return: 0 on success, or the panel's error code.
+ */
+int msm_dsi_switch_mode(struct msm_dsi *msm_dsi,
+			const struct drm_display_mode *mode)
+{
+	struct drm_panel *panel = drm_panel_bridge_get_panel(msm_dsi->next_bridge);
+
+	msm_dsi_host_update_display_mode(msm_dsi->host, mode);
+
+	return drm_panel_switch_mode(panel, mode);
+}
