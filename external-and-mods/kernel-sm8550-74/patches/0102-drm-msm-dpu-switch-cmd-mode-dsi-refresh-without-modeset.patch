 	return &cstate->base;
 }
 
@@ -1514,6 +1528,44 @@ static int dpu_crtc_assign_resources(struct drm_crtc *crtc,
 	return 0;
 }
 
+static bool dpu_seamless_vfp = true;
+MODULE_PARM_DESC(dpu_seamless_vfp,
+		 "Change the vertical front porch (refresh rate) of a command mode DSI panel without a modeset when the panel supports it (1=on (default), 0=always modeset)");
+module_param(dpu_seamless_vfp, bool, 0644);
+
+/*
+ * A mode change the CRTC can make without a modeset: the CRTC stays active
+ * on the same single encoder (no clone mode), and that encoder (and, behind
+ * it, the panel) can follow the new timings while running. In practice a
+ * vertical front porch change on a command mode DSI panel, see
+ * dpu_encoder_can_switch_mode().
+ */
+
+static bool dpu_crtc_can_switch_mode(const struct drm_crtc_state *old_crtc_state,
+				     const struct drm_crtc_state *new_crtc_state,
+				     const struct drm_display_mode *old_mode,
+				     const struct drm_display_mode *new_mode)
+{
+	struct drm_encoder *drm_enc;
+
+	if (!READ_ONCE(dpu_seamless_vfp) ||
+	    !old_crtc_state->active || !new_crtc_state->active ||
+	    new_crtc_state->active_changed ||
+	    new_crtc_state->connectors_changed ||
+	    hweight32(new_crtc_state->encoder_mask) != 1 ||
+	    old_crtc_state->encoder_mask != new_crtc_state->encoder_mask ||
+	    drm_mode_equal(old_mode, new_mode))
+		return false;
+
+	drm_for_each_encoder_mask(drm_enc, new_crtc_state->crtc->dev,
+				  new_crtc_state->encoder_mask) {
+		if (!dpu_encoder_can_switch_mode(drm_enc, old_mode, new_mode))
+			return false;
+	}
+
+	return true;
+}
+
 /**
  * dpu_crtc_check_mode_changed: check if full modeset is required
  * @old_crtc_state:	Previous CRTC state
@@ -1526,6 +1578,7 @@ int dpu_crtc_check_mode_changed(struct drm_crtc_state *old_crtc_state,
 {
 	struct drm_encoder *drm_enc;
 	struct drm_crtc *crtc = new_crtc_state->crtc;
+	struct dpu_crtc_state *cstate = to_dpu_crtc_state(new_crtc_state);
 	bool clone_mode_enabled = drm_crtc_in_clone_mode(old_crtc_state);
 	bool clone_mode_requested = drm_crtc_in_clone_mode(new_crtc_state);
 
@@ -1541,6 +1594,18 @@ int dpu_crtc_check_mode_changed(struct drm_crtc_state *old_crtc_state,
 	    (!clone_mode_requested && clone_mode_enabled))
 		new_crtc_state->mode_changed = true;
 
+	/*
+	 * The DRM helpers have not compared the modes yet, so mode_changed
+	 * is only set here for reasons that need a modeset whatever the mode
+	 * (CTM toggle, CDM, clone mode). Without one, a mode change that can
+	 * be done on the fly is a candidate; dpu_crtc_atomic_check() decides
+	 * once the adjusted mode is known.
+	 */
+	cstate->switch_mode = !new_crtc_state->mode_changed &&
+		dpu_crtc_can_switch_mode(old_crtc_state, new_crtc_state,
+					 &old_crtc_state->mode,
+					 &new_crtc_state->mode);
+
 	return 0;
 }
 
@@ -1559,6 +1624,22 @@ static int dpu_crtc_atomic_check(struct drm_crtc *crtc,
 
 	bool needs_dirtyfb = dpu_crtc_needs_dirtyfb(crtc_state);
 
+	if (cstate->switch_mode) {
+		const struct drm_crtc_state *old_crtc_state =
+			drm_atomic_get_old_crtc_state(state, crtc);
+
+		cstate->switch_mode = crtc_state->mode_changed &&
+			dpu_crtc_can_switch_mode(old_crtc_state, crtc_state,
+						 &old_crtc_state->adjusted_mode,
+						 &crtc_state->adjusted_mode);
+		if (cstate->switch_mode) {
+			DRM_DEBUG_ATOMIC("crtc%d: " DRM_MODE_FMT " without a modeset\n",
+					 crtc->base.id,
+					 DRM_MODE_ARG(&crtc_state->adjusted_mode));
+			crtc_state->mode_changed = false;
+		}
+	}
+
 	/* don't reallocate resources if only ACTIVE has beeen changed */
 	if (crtc_state->mode_changed || crtc_state->connectors_changed ||
 	    crtc_state->color_mgmt_changed) {
