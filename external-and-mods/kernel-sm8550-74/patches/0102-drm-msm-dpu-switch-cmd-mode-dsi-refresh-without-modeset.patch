+/**
+ * drm_panel_bridge_get_panel - Returns the panel a panel_bridge wraps.
+ *
+ * @bridge: The drm_bridge, or NULL.
+ *
+ * Returns: the &drm_panel behind @bridge, or NULL if @bridge is not a
+ * panel_bridge.
+ */
+struct drm_panel *drm_panel_bridge_get_panel(struct drm_bridge *bridge)
+{
+	if (!bridge || !drm_bridge_is_panel(bridge))
+		return NULL;
+
+	return drm_bridge_to_panel(bridge);
+}
+EXPORT_SYMBOL(drm_panel_bridge_get_panel);
+
