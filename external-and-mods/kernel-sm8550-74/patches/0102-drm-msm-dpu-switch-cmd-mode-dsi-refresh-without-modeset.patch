+/**
+ * dpu_encoder_can_switch_mode - check whether the running encoder can follow
+ *	a mode change without a modeset
+ * @drm_enc: Pointer to drm encoder structure
+ * @old_mode: adjusted mode the encoder runs
+ * @new_mode: adjusted mode to switch to
+ *
+ * Only a command mode panel on a single DSI interface qualifies: it scans
+ * out at its own frame length and paces the encoder through TE, so the
+ * encoder only has to adapt its tear check to the new vtotal (see
+ * dpu_encoder_switch_mode()). The DSI side accepts a vertical front porch
+ * change at the same pixel clock only, and only if the panel can switch
+ * its frame length while enabled; the layer mixer topology, which depends
+ * on the width and clock, is unchanged by such a switch.
+ *
+ * Return: true if dpu_encoder_switch_mode() can do the switch.
+ */
+bool dpu_encoder_can_switch_mode(struct drm_encoder *drm_enc,
+				 const struct drm_display_mode *old_mode,
+				 const struct drm_display_mode *new_mode)
+{
+	struct dpu_encoder_virt *dpu_enc = to_dpu_encoder_virt(drm_enc);
+	struct msm_drm_private *priv = drm_enc->dev->dev_private;
+	const struct msm_display_info *disp_info = &dpu_enc->disp_info;
+
+	if (disp_info->intf_type != INTF_DSI || !disp_info->is_cmd_mode ||
+	    disp_info->num_of_h_tiles != 1 || dpu_enc->num_phys_encs != 1)
+		return false;
+
+	return msm_dsi_can_switch_mode(priv->kms->dsi[disp_info->h_tile_instance[0]],
+				       old_mode, new_mode);
+}
+
+/**
+ * dpu_encoder_switch_mode - follow a mode change accepted by
+ *	dpu_encoder_can_switch_mode()
+ * @drm_enc: Pointer to drm encoder structure
+ * @old_mode: adjusted mode the encoder runs
+ * @new_mode: adjusted mode to switch to
+ *
+ * Called from the CRTC's atomic_begin, before the first frame of @new_mode
+ * is flushed.
+ */
+void dpu_encoder_switch_mode(struct drm_encoder *drm_enc,
+			     const struct drm_display_mode *old_mode,
+			     const struct drm_display_mode *new_mode)
+{
+	struct dpu_encoder_virt *dpu_enc = to_dpu_encoder_virt(drm_enc);
+	struct msm_drm_private *priv = drm_enc->dev->dev_private;
+	const struct msm_display_info *disp_info = &dpu_enc->disp_info;
+	int i, ret;
+
+	DPU_DEBUG_ENC(dpu_enc, DRM_MODE_FMT "\n", DRM_MODE_ARG(new_mode));
+
+	/* Let the last frame reach the panel before touching the TE setup */
+	dpu_encoder_wait_for_tx_complete(drm_enc);
+
+	for (i = 0; i < dpu_enc->num_phys_encs; i++) {
+		struct dpu_encoder_phys *phys = dpu_enc->phys_encs[i];
+
+		phys->cached_mode = *new_mode;
+		if (phys->ops.switch_mode)
+			phys->ops.switch_mode(phys, old_mode);
+	}
+
+	ret = msm_dsi_switch_mode(priv->kms->dsi[disp_info->h_tile_instance[0]],
+				  new_mode);
+	if (ret)
+		DPU_ERROR_ENC(dpu_enc, "panel did not switch to " DRM_MODE_FMT ": %d\n",
+			      DRM_MODE_ARG(new_mode), ret);
+}
