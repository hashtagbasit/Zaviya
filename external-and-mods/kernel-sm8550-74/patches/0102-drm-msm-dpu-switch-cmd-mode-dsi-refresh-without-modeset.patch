+/*
+ * Change the mode of a running host in place, for msm_dsi_switch_mode():
+ * unlike msm_dsi_host_set_display_mode() this never frees msm_host->mode,
+ * which a concurrent command transfer may be reading (hdisplay, unchanged).
+ */
+void msm_dsi_host_update_display_mode(struct mipi_dsi_host *host,
+				      const struct drm_display_mode *mode)
+{
+	struct msm_dsi_host *msm_host = to_msm_dsi_host(host);
+
+	if (msm_host->mode)
+		drm_mode_copy(msm_host->mode, mode);
+}
