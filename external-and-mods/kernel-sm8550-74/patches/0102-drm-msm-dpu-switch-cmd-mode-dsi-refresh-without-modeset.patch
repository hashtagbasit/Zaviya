  * devm_drm_of_get_bridge - Return next bridge in the chain
@@ -890,6 +907,56 @@ int drm_panel_get_modes(struct drm_panel *panel,
 }
 EXPORT_SYMBOL(drm_panel_get_modes);
 
+/**
+ * drm_panel_can_switch_mode - check whether an enabled panel can change mode
+ * @panel: DRM panel
+ * @old_mode: mode the panel runs
+ * @new_mode: mode to switch to
+ *
+ * Display drivers that can themselves follow a mode change without
+ * disabling the output call this from atomic check to find out whether the
+ * panel can follow it too, through drm_panel_switch_mode().
+ *
+ * Return: true if the panel can switch from @old_mode to @new_mode while
+ * enabled, false if the transition needs a full modeset.
+ */
+bool drm_panel_can_switch_mode(struct drm_panel *panel,
+			       const struct drm_display_mode *old_mode,
+			       const struct drm_display_mode *new_mode)
+{
+	if (!panel || !panel->funcs || !panel->funcs->can_switch_mode ||
+	    !panel->funcs->switch_mode)
+		return false;
+
+	return panel->funcs->can_switch_mode(panel, old_mode, new_mode);
+}
+EXPORT_SYMBOL(drm_panel_can_switch_mode);
+
+/**
+ * drm_panel_switch_mode - switch an enabled panel to another mode
+ * @panel: DRM panel
+ * @mode: mode to switch to
+ *
+ * Only for transitions drm_panel_can_switch_mode() accepted.
+ *
+ * Return: 0 on success or a negative error code on failure.
+ */
+int drm_panel_switch_mode(struct drm_panel *panel,
+			  const struct drm_display_mode *mode)
+{
+	if (!panel)
+		return -EINVAL;
+
+	if (!panel->funcs || !panel->funcs->switch_mode)
+		return -EOPNOTSUPP;
+
+	if (!panel->enabled)
+		return -EINVAL;
+
+	return panel->funcs->switch_mode(panel, mode);
+}
+EXPORT_SYMBOL(drm_panel_switch_mode);
